<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Bewusst deaktiviert: Das Arbeitsblatt schreibt Felder als
             "public string Titel;" ohne Startwert. Mit aktivierten
             Nullable-Referenztypen wuerde das pro Feld eine Warnung geben. -->
        <Nullable>disable</Nullable>
    </PropertyGroup>

</Project>
